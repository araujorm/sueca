include Makedefs

 # Automatic dependency generation
sinclude $(DEPS)

sueca: $(OBJS)
	$(CXX) $(LDFLAGS) $^ -o $@
	$(STRIP) $@

# Implicit rules
.cpp.o:
	$(CXX) $(CXXFLAGS) -c $< -o $@

png/%.h: png/%.png
	xxd -i -n $* $< > $@

icons/%.h: icons/%.png
	xxd -i -n $* $< > $@

%.d: %.cpp $(PNG_HEADERS) $(ICON_HEADERS)
	set -e; $(CXX) -MM $(CXXFLAGS) $< \
		| sed 's/\($*\)\.o[ :]*/\1.o $@ : /g' > $@; \
		[ -s $@ ] || rm -f $@
