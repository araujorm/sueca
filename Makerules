include Makedefs

 # Automatic dependency generation
sinclude $(DEPS)

sueca: $(OBJS)
	$(CXX) $(LDFLAGS) $(OBJS) -o $@
	$(STRIP) $@

# Implicit rules
.cpp.o:
	$(CXX) $(CXXFLAGS) -c $< -o $@

png/%.h: png/%.png
	xxd -i -n $* $< > $@

icons/%.h: icons/%.png
	xxd -i -n $* $< > $@

%.d: %.cpp $(PNG_HEADERS) $(ICON_HEADERS)
	set -e; $(CXX) -MM $(CXXFLAGS) $< \
		| sed 's/\($*\)\.o[ :]*/\1.o $@ : /g' > $@; \
		[ -s $@ ] || rm -f $@

# --- Translations -----------------------------------------------------
# Strings are marked in the source with _("...") (runtime lookup) or
# wxTRANSLATE("...") (static context). xgettext extracts them into
# po/sueca.pot; each po/<locale>.po is kept in sync manually (or via
# `make update-po`) and msgfmt compiles it into the matching .mo under
# mo/<locale>/LC_MESSAGES/ at build time.

po/sueca.pot: $(SRCS) $(HEADERS)
	@mkdir -p po
	xgettext --from-code=UTF-8 --language=C++ \
		--keyword=_ --keyword=wxTRANSLATE \
		--package-name=sueca --copyright-holder="Rodrigo Araujo" \
		--msgid-bugs-address="$(BUGS_ADDRESS)" \
		-o $@ $(SRCS) $(HEADERS)

# Merge newly extracted messages back into every existing translation
# without losing already-translated entries. Explicit target: run
# `make update-po` after changing source strings.
.PHONY: update-po
update-po: po/sueca.pot
	@for po in $(PO_FILES); do \
		echo "msgmerge $$po"; \
		msgmerge --update --backup=none --quiet $$po po/sueca.pot; \
	done

mo/%/LC_MESSAGES/sueca.mo: po/%.po
	@mkdir -p $(dir $@)
	msgfmt -o $@ $<

# Convert each compiled .mo into a C byte array so it can be linked
# into the executable. The identifier has dashes replaced with
# underscores to keep it a valid C name.
mo/%.h: mo/%/LC_MESSAGES/sueca.mo
	xxd -i -n sueca_mo_$(subst -,_,$*) $< > $@

# Aggregate every per-locale header into the lookup table consumed by
# SuecaCatalogLoader. Regenerated whenever a .po is added/removed.
embedded_mo.cpp: $(MO_HEADERS) Makerules Makedefs.common
	@( echo '// Auto-generated by Makerules; do not edit.'; \
	   echo '#include "embedded_mo.hpp"'; \
	   for l in $(LOCALE_IDS); do \
	     echo "#include \"mo/$$l.h\""; \
	   done; \
	   echo ''; \
	   echo 'const EmbeddedMo kEmbeddedMos[] = {'; \
	   for l in $(LOCALE_IDS); do \
	     id=`echo $$l | tr - _`; \
	     echo "	{ \"$$l\", sueca_mo_$$id, sueca_mo_$${id}_len },"; \
	   done; \
	   echo '	{ 0, 0, 0 }'; \
	   echo '};' ) > $@
