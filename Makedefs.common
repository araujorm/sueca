SRCS = main.cpp myframe.cpp cards.cpp mycanvas.cpp game.cpp player.cpp \
	scoredialog.cpp trumphdialog.cpp prefsdialog.cpp observingbot.cpp \
	smartplayer.cpp methodicplayer.cpp expertplayer.cpp smarttactics.cpp \
	lang.cpp lasttrickdialog.cpp \
	chatpanel.cpp serverhandler.cpp serverdialog.cpp netserverplayer.cpp \
	netcommon.cpp remotedialog.cpp remotegame.cpp remotehandler.cpp \
	hostedgame.cpp
HEADERS = $(wildcard *.hpp)
OBJS = $(SRCS:.cpp=.o)
DEPS = $(SRCS:.cpp=.d)
PNG_FILES = $(wildcard png/*.png)
PNG_HEADERS = $(PNG_FILES:.png=.h)
ICON_HEADERS = icons/icon32.h

# URL where bug reports should be sent (used in po/sueca.pot header).
BUGS_ADDRESS = https://github.com/araujorm/sueca/issues

# Translations: list of locales whose .po files live under po/ and
# compile to mo/<locale>/LC_MESSAGES/sueca.mo at build time.
PO_FILES = $(wildcard po/*.po)
MO_FILES = $(patsubst po/%.po,mo/%/LC_MESSAGES/sueca.mo,$(PO_FILES))
