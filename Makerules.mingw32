include Makedefs.mingw32

 # Automatic dependency generation
sinclude $(DEPS)

sueca.exe: $(OBJS) sueca_private.res
	$(CXX) -o $@ $^ $(LDFLAGS)
	$(STRIP) $@

sueca_private.res: sueca_private.rc sueca_resources.rc
	$(WINDRES) -i sueca_private.rc -I rc -o sueca_private.res -O coff

# Implicit rules
.cpp.o:
	$(CXX) $(CXXFLAGS) -c $< -o $@

png/%.h: png/%.png
	xxd -i -n $* $< > $@

icons/%.h: icons/%.png
	xxd -i -n $* $< > $@

mo/%/LC_MESSAGES/sueca.mo: po/%.po
	@mkdir -p $(dir $@)
	msgfmt -o $@ $<

mo/%.h: mo/%/LC_MESSAGES/sueca.mo
	xxd -i -n sueca_mo_$(subst -,_,$*) $< > $@

embedded_mo.cpp: $(MO_HEADERS) Makerules.mingw32 Makedefs.common
	@( echo '// Auto-generated by Makerules.mingw32; do not edit.'; \
	   echo '#include "embedded_mo.hpp"'; \
	   for l in $(LOCALE_IDS); do \
	     echo "#include \"mo/$$l.h\""; \
	   done; \
	   echo ''; \
	   echo 'const EmbeddedMo kEmbeddedMos[] = {'; \
	   for l in $(LOCALE_IDS); do \
	     id=`echo $$l | tr - _`; \
	     echo "	{ \"$$l\", sueca_mo_$$id, sueca_mo_$${id}_len },"; \
	   done; \
	   echo '	{ 0, 0, 0 }'; \
	   echo '};' ) > $@

%.d: %.cpp $(PNG_HEADERS) $(ICON_HEADERS)
	set -e; $(CXX) -MM $(CXXFLAGS) $< \
		| sed 's/\($*\)\.o[ :]*/\1.o $@ : /g' > $@; \
		[ -s $@ ] || rm -f $@
